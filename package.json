{
  "name": "n8n-nodes-beachday",
  "version": "1.0.9",
  "description": "Beach Day API for n8n — real-time beach conditions, tides, water quality, and Beach Day Scores™ across 34,000+ beaches in 103 countries",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "beach",
    "weather",
    "tides",
    "surf",
    "water-quality",
    "ocean"
  ],
  "license": "MIT",
  "author": {
    "name": "Beach Day API",
    "email": "ryanv@versusmedia.com",
    "url": "https://beachdayapi.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rv888/n8n-nodes-beachday.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && cp nodes/BeachDay/beachday.svg dist/nodes/BeachDay/beachday.svg",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist/"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodes": [
      "dist/nodes/BeachDay/BeachDay.node.js"
    ],
    "credentials": [
      "dist/credentials/BeachDayApi.credentials.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "n8n-workflow": "latest",
    "typescript": "^5.5.0",
    "@types/node": "^20.0.0",
    "@types/express": "^4.17.21"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
